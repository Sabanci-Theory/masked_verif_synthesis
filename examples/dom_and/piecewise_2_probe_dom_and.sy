(set-logic BV)

(declare-datatypes ((Pair 2)) ((par (T1 T2) ((mk-pair (first T1) (second T2))))))
(declare-datatypes ((Rands 3)) ((par (T1 T2 T3) ((mk-rands (r0 T1) (r1 T2) (r2 T3))))))

; *** 1- configuration ***

; w = [(a + r0) * r1 , ((b + r1) * r0) + r2]
(define-fun w ((a (_ BitVec 1)) (b (_ BitVec 1)) (r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))))
	(Pair (_ BitVec 1) (_ BitVec 1))
	(mk-pair
    (bvand (bvxor a (r0 r)) (r1 r))
    (bvxor (bvand (bvxor b (r1 r)) (r0 r)) (r2 r))
  )
)

; *** 2- synthesis ***

;(synth-fun f ((a (_ BitVec 1)) (b (_ BitVec 1)) (ap (_ BitVec 1)) (bp (_ BitVec 1)) (r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))))
;  (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))
;  (
;		(T (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1)))
;		(S (_ BitVec 1))
;		(Cond Bool)
;		(B (_ BitVec 1))
;	)
;  (
;		(T (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1)) ((mk-rands S S S)))
;    (S (_ BitVec 1) (B (ite Cond S S)))
;    (Cond Bool ((= ap #b0) (= bp #b0)))
;    (B (_ BitVec 1) (a b ap bp (r0 r) (r1 r) (r2 r) #b0 #b1 (bvxor B B) (bvand B B)))
;  )
;)

(synth-fun f0 ((a (_ BitVec 1)) (b (_ BitVec 1)) (ap (_ BitVec 1)) (bp (_ BitVec 1)) (r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))))
	(_ BitVec 1)
	(
		(S (_ BitVec 1))
		(Cond Bool)
		(B (_ BitVec 1))
	)
	(
    (S (_ BitVec 1) (B (ite Cond S S)))
    (Cond Bool ((= ap #b0) (= bp #b0)))
    (B (_ BitVec 1) ((bvxor a (r0 r)) ap (r0 r) (r1 r) #b0 #b1 (bvxor B B) (bvand B B)))
	)
)

(synth-fun f1 ((a (_ BitVec 1)) (b (_ BitVec 1)) (ap (_ BitVec 1)) (bp (_ BitVec 1)) (r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))))
	(_ BitVec 1)
	(
		(S (_ BitVec 1))
		(Cond Bool)
		(B (_ BitVec 1))
	)
	(
    (S (_ BitVec 1) (B (ite Cond S S)))
    (Cond Bool ((= ap #b0) (= bp #b0)))
    (B (_ BitVec 1) ((bvxor a (r0 r)) ap (r0 r) (r1 r) #b0 #b1 (bvxor B B) (bvand B B)))
	)
)

; f2 = ((b + r1) * r0) + r2 + ((bp + _1) * _0)
;(synth-fun f2 ((a (_ BitVec 1)) (b (_ BitVec 1)) (ap (_ BitVec 1)) (bp (_ BitVec 1)) (r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))))
;  (_ BitVec 1)
;  (
;		(S (_ BitVec 1))
;		(Cond Bool)
;		(B (_ BitVec 1))
;	)
;  (
;    (S (_ BitVec 1) (B (ite Cond S S)))
;    (Cond Bool ((= ap #b0)))
;    (B (_ BitVec 1) (a b ap bp (r0 r) (r1 r) (r2 r) #b0 #b1 (bvxor B B) (bvand B B)))
;  )
;)

(define-fun f2 ((a (_ BitVec 1)) (b (_ BitVec 1)) (ap (_ BitVec 1)) (bp (_ BitVec 1)) (r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))) (f0 (_ BitVec 1)) (f1 (_ BitVec 1)))
	(_ BitVec 1)
	(bvxor (bvxor (bvand (bvxor b (r1 r)) (r0 r)) (r2 r)) (bvand (bvxor bp f1) f0))
)

; *** 3- constraints ***

(declare-var a (_ BitVec 1))
(declare-var b (_ BitVec 1))
(declare-var r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1)))
(declare-var ap (_ BitVec 1))
(declare-var bp (_ BitVec 1))
(declare-var rp (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1)))

;(constraint 
;  (= 
;    (w a b r) 
;    (w ap bp (f a b ap bp r))
;  )
;)
;
;(constraint 
;  (=> 
;    (= (f a b ap bp r) (f a b ap bp rp)) 
;    (= r rp)
;  )
;)

(constraint
	(let ((f0 (f0 a b ap bp r)) (f1 (f1 a b ap bp r)))
		(= 
			(w a b r) 
			(w ap bp (mk-rands f0 f1 (f2 a b ap bp r f0 f1)))
		)
	)
)

(constraint
	(let ((f0 (f0 a b ap bp r)) (f1 (f1 a b ap bp r)) (fp0 (f0 a b ap bp rp)) (fp1 (f1 a b ap bp rp)))
		(=> 
			(and 
				(= f0 fp0)
				(= f1 fp1)
				(= (f2 a b ap bp r f0 f1) (f2 a b ap bp rp fp0 fp1))
			)
			(= r rp)
		)
	)
)

(check-synth)
