(set-logic BV)

(declare-datatypes ((Pair 2)) ((par (T1 T2) ((mk-pair (first T1) (second T2))))))
(declare-datatypes ((Rands 3)) ((par (T1 T2 T3) ((mk-rands (r0 T1) (r1 T2) (r2 T3))))))

; *** 1- configuration ***

; w = [(a + r0) * r1, ((b + r1) * r0) + r2] = [a * r1 + r0 * r1, b * r0 + r1 * r0 + r2]
(define-fun w ((a (_ BitVec 1)) (b (_ BitVec 1)) (r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))))
  (Pair (_ BitVec 1) (_ BitVec 1))
  (mk-pair (
							bvxor (bvand a (r1 r)) (bvand (r0 r) (r1 r))
					 )
					 (
							bvxor (bvand b (r0 r)) (bvxor (bvand (r0 r) (r1 r)) (r2 r))
					 )
  )
)

; *** 2- synthesis ***

; f calculates the new r pair
(synth-fun f ((a (_ BitVec 1)) (b (_ BitVec 1)) (ap (_ BitVec 1)) (bp (_ BitVec 1)) (r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))))
  (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1))
  (
    (T (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1)))
    (B (_ BitVec 1))
  )
  (
    (T (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1)) ((mk-rands B B B)))							; T :== (B, B, B)
    (B (_ BitVec 1) (a b ap bp (r0 r) (r1 r) (r2 r) (bvxor B B) (bvand B B)))        	; B :== a | b | ap | bp | r0 | r1 | r2 | B + B | B * B
  )
)

; *** 3- constraints ***

; universally quantified variables
(declare-var a (_ BitVec 1))
(declare-var b (_ BitVec 1))
(declare-var r (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1)))
(declare-var ap (_ BitVec 1))
(declare-var bp (_ BitVec 1))
(declare-var rp (Rands (_ BitVec 1) (_ BitVec 1) (_ BitVec 1)))

; invariance on a and b
(constraint 
  (= 
    (w a b r) 
    (w ap bp (f a b ap bp r))
  )
)

; bijectivity of f
(constraint 
  (=> 
    (= (f a b ap bp r) (f a b ap bp rp)) 
    (= r rp)
  )
)

(check-synth)


; pen-and-paper derivation of a correct witness:

; f = _0, _1, ((b + r1) * r0) + r2 + ((bp + _1) * _0)

; (a + r0) * r1 = (ap + _0) * _1
; a * r1 + r0 * r1 = ap * _1 + _0 * _1

; ((b + r1) * r0) + r2 = ((bp + _1) * _0) + rp2

; f | ap = 0 => a * r1 + r0 * r1 = _0 * _1 => _0 := a + r0 ; _1 := r1
;   | ap = 1 => a * r1 + r0 * r1 = r1 * (a + r0)
;               _1 + _0 * _1 = _1 * (1 + _0) => _0 := 1 + a + r0 ; _1 := r1

; f | ap = 0 => a + r0, r1, ((b + r1) * r0) + r2 + ((bp + r1) * (a + r0))
;   | ap = 1 => 1 + a + r0, r1, ((b + r1) * r0) + r2 + ((bp + r1) * (1 + a + r0))

; f = (1 + ap) * (a + r0, r1, ((b + r1) * r0) + r2 + ((bp + r1) * (a + r0))) + ap * (1 + a + r0, r1, ((b + r1) * r0) + r2 + ((bp + r1) * (1 + a + r0)))
